# Log source mode: "file" or "journald"
MAIL_LOG_SOURCE=file

# Path to the active Postfix log file (used when MAIL_LOG_SOURCE=file)
MAIL_LOG_PATH=/var/log/mail.log

# Whether to also read rotated logs (mail.log.1 and mail.log.*.gz) in "file" mode
MAIL_LOG_INCLUDE_ROTATED=true

# Maximum lines to fetch when MAIL_LOG_SOURCE=journald
MAIL_LOG_MAX_LINES=5000

# Timezone used to interpret BSD syslog timestamps (which omit timezone & year)
TZ=UTC

# Server port (used by Next.js / PM2)
PORT=3099

# Disable Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1
